# Copy to .env (gitignored) and change every password.
# Leave this enabled to run the bundled MySQL service. Set it to an empty
# value and configure DB_URL/DB_USER/DB_PASSWORD below to use an external one.
COMPOSE_PROFILES=embedded-db
MYSQL_DATABASE=smarthome
MYSQL_USER=smarthome
MYSQL_PASSWORD=change-me-db
MYSQL_ROOT_PASSWORD=change-me-root-db
# DB_URL=jdbc:mysql://database.example.com:3306/smarthome?connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true
# DB_USER=smarthome
# DB_PASSWORD=change-me-external-db
MQTT_SERVER_USERNAME=server
MQTT_SERVER_PASSWORD=change-me-mqtt
HTTP_PORT=80
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=change-me-admin-strong
BOOTSTRAP_ADMIN_DISPLAY_NAME=System Administrator
# Set true only when the public endpoint is served over HTTPS.
SESSION_COOKIE_SECURE=false
